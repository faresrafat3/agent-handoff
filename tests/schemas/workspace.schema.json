{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "continuum/workspace/v1",
  "type": "object",
  "required": ["schema_version", "kind", "id", "name", "mode", "layout", "scopes", "policy"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "WorkspaceManifest"},
    "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "mode": {"enum": ["minimal", "full"]},
    "layout": {"enum": ["single", "monorepo"]},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "default_scope": {"type": "string"},
    "scopes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "path", "kind"], "properties": {"id": {"type": "string"}, "path": {"type": "string"}, "kind": {"type": "string"}, "package": {"type": ["string", "null"]}, "depends_on": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true}},
    "policy": {"type": "object"},
    "extensions": {"type": "object"}
  },
  "additionalProperties": false
}
